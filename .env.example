# Telegram bot (BotFather) and admin list
TELEGRAM_BOT_TOKEN=123456:replace-me
# Comma-separated Telegram user ids that may add products
TELEGRAM_ADMIN_IDS=123456789
# Public https URL of the catalog (used by the Mini App button in the bot)
MINI_APP_URL=https://your-domain.example/

# Shared secret: the bot signs product-creation requests with it
INTERNAL_TOKEN=dev-internal-token

# PostgreSQL
POSTGRES_USER=catalog
POSTGRES_PASSWORD=catalog
POSTGRES_DB=catalog

# MinIO
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=catalog-images

# Host port the whole stack is published on (nginx)
HTTP_PORT=8080
